{
  "name": "kizami",
  "version": "0.8.9",
  "type": "module",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=24.14.1"
  },
  "bin": {
    "kizami": "./dist/cli.js"
  },
  "scripts": {
    "build": "vite build && chmod +x dist/cli.js",
    "e2e": "pnpm build && vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ tests/ vite.config.ts vitest.stryker.config.ts",
    "format": "oxfmt --check src/ tests/",
    "format:fix": "oxfmt src/ tests/",
    "doclint": "node tools/doclint.mjs",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "bench": "tsx tests/perf/bench.ts",
    "secretlint": "secretlint --secretlintrc .secretlintrc.json '**/*.{ts,js,md,json,yml,yaml}' --maskSecrets",
    "prepare": "husky",
    "check": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm format && pnpm secretlint && pnpm build && pnpm test"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "tests/**/*.{ts,js}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "better-sqlite3": "13.0.3",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "secretlint": "^13.0.2",
    "semantic-release": "25.0.5",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "vite": "8.1.6",
    "vitest": "5.0.5"
  }
}
